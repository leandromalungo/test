# ==============================================================================
# NOSSA AgroParamétrico — Ficheiro de Exemplo de Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este ficheiro para ".env.local" (ficheiro principal usado pelo Next.js)
# e preencha com os seus valores reais. NUNCA envie ".env.local" para o GitHub.
#
# NOTA: Sem as chaves do Supabase preenchidas, a plataforma arranca em
# "Modo Demonstração" com persistência local para testes imediatos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de Dados PostgreSQL + Autenticação) — Obrigatório em Produção
# ------------------------------------------------------------------------------
# Onde obter:
#   1. Aceda a https://supabase.com/dashboard e crie ou seleccione o seu projecto.
#   2. No menu lateral, vá a: Project Settings (ícone engrenagem) -> Data API / API Keys.
#   3. Copie "Project URL" para NEXT_PUBLIC_SUPABASE_URL.
#   4. Copie "anon / public" (ou Publishable key) para NEXT_PUBLIC_SUPABASE_ANON_KEY.
#   5. Copie "service_role" (ou Secret key) para SUPABASE_SERVICE_ROLE_KEY.
#      (ATENÇÃO: nunca exponha SUPABASE_SERVICE_ROLE_KEY com prefixo NEXT_PUBLIC_!)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# ------------------------------------------------------------------------------
# 2. SEGURANÇA INTERNA DA APLICAÇÃO (Gerados localmente por si)
# ------------------------------------------------------------------------------
# Estas chaves NÃO vêm de nenhum site externo — são segredos que você mesmo cria.
# Como gerar no terminal (Linux/macOS/Git Bash):
#   openssl rand -hex 32
# Ou com Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
SESSION_SECRET=altere-para-um-segredo-aleatorio-de-64-caracteres-hex
CRON_SECRET=altere-para-um-token-aleatorio-para-proteger-o-cron

# ------------------------------------------------------------------------------
# 3. PROVEDORES CLIMÁTICOS EXTERNOS (NÃO EXIGEM CHAVE DE API PARA AVALIAÇÃO)
# ------------------------------------------------------------------------------
# Open-Meteo ERA5 (Primária) e NASA POWER (Confirmação) são APIs abertas e
# funcionam sem chave de API para avaliação. Apenas os URLs base são opcionais.
# ------------------------------------------------------------------------------
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
NASA_POWER_DAILY_URL=https://power.larc.nasa.gov/api/temporal/daily/point
